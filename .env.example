# Copy to .env and fill in. .env is gitignored — never commit real keys.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_CHEAP=gpt-4o-mini

# Optional: a GitHub token raises the issue-search rate limit (public repos work without it)
# GITHUB_TOKEN=ghp_...

# Optional: set to 1 to print OpenTelemetry spans to the console
# OTEL_CONSOLE=1
